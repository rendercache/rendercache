{
  "origin": "http://127.0.0.1:8081",
  "listen": "127.0.0.1:8080",
  "admin_listen": "127.0.0.1:9090",
  "origin_timeout": "30s",
  "shutdown_timeout": "10s",
  "bots": [
    "Googlebot",
    "bingbot",
    "OAI-SearchBot",
    "GPTBot",
    "ChatGPT-User",
    "ClaudeBot",
    "Claude-SearchBot",
    "Claude-User",
    "PerplexityBot",
    "Perplexity-User",
    "facebookexternalhit",
    "Twitterbot",
    "LinkedInBot"
  ],
  "public_url": "https://public.example",
  "data_dir": "data/snapshots",
  "render_timeout": "30s",
  "render_settle": "500ms",
  "ready_selector": "main[data-ready]",
  "max_html_bytes": 8388608,
  "render_concurrency": 1,
  "render_allow_origins": [],
  "chrome_no_sandbox": false,
  "warm_enabled": true,
  "sitemap_urls": [
    "/sitemap.xml"
  ],
  "warm_interval": "24h",
  "sitemap_interval": "15m",
  "warm_retry_base": "5s",
  "warm_retry_max": "5m",
  "warm_queue_size": 128,
  "sitemap_max_bytes": 8388608,
  "sitemap_max_urls": 10000,
  "sitemap_max_documents": 128,
  "sitemap_max_depth": 4,
  "sitemap_timeout": "15s",
  "sitemap_scan_timeout": "2m",
  "snapshot_enabled": true,
  "snapshot_ttl": "24h",
  "request_page_limit": 256,
  "delivery_log_max_bytes": 10485760,
  "delivery_log_backups": 3
}
